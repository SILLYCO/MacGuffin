# Database connection string (PostgreSQL via Supabase, Neon, Docker, or local PG)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/it_asset_db?schema=public"

# NextAuth Secret (Generate with `openssl rand -base64 32`)
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Initial IT Administrator credentials (used by `pnpm prisma:seed`)
INITIAL_IT_EMAIL="admin@company.com"
INITIAL_IT_PASSWORD="AdminPassword123!"

# CCTV DVR & Gateway Configuration
DVR_HOST="192.168.1.114"
DVR_RTSP_PORT="554"
DVR_HTTP_PORT="80"
DVR_USER="admin"
DVR_PASS="your-dvr-password"
GO2RTC_API_URL="http://127.0.0.1:1984"

