generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  IT
  MANAGER
}

enum DeviceStatus {
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  RETIRED
}

enum AuditAction {
  DEVICE_CREATED
  DEVICE_UPDATED
  DEVICE_STATUS_CHANGED
  DEVICE_ASSIGNED
  DEVICE_UNASSIGNED
  DEVICE_DELETED
  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  EMPLOYEE_DELETED
  USER_CREATED
  USER_ROLE_UPDATED
  USER_PASSWORD_RESET
  USER_DELETED
}

enum AuditEntityType {
  DEVICE
  EMPLOYEE
  USER
  ASSIGNMENT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(MANAGER)
  employeeId   String?    @unique
  employee     Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Employee {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  department  String
  user        User?
  assignments Assignment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Device {
  id             String       @id @default(cuid())
  brand          String
  model          String
  cpu            String
  ram            String
  storage        String
  serialNumber   String       @unique
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  status         DeviceStatus   @default(IN_STOCK)
  assignments    Assignment[]
  repairs        RepairRecord[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Assignment {
  id           String    @id @default(cuid())
  deviceId     String
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  @@index([deviceId])
  @@index([employeeId])
}

model RepairRecord {
  id               String    @id @default(cuid())
  deviceId         String
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issueDescription String
  resolutionNotes  String?
  vendor           String?
  reportedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  reportedByEmail  String
  resolvedByEmail  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([deviceId])
  @@index([resolvedAt])
}

model AuditLog {
  id          String          @id @default(cuid())
  action      AuditAction
  entityType  AuditEntityType
  entityId    String?
  entityName  String?
  actorId     String?
  actor       User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String
  actorRole   Role
  details     String?         // Formatted JSON string containing action metadata/diff
  createdAt   DateTime        @default(now())

  @@index([action])
  @@index([entityType])
  @@index([actorEmail])
  @@index([createdAt])
}
