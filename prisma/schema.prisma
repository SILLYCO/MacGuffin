generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  IT
  MANAGER
}

enum DeviceStatus {
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  RETIRED
}

enum DeviceType {
  LAPTOP
  DESKTOP_PC
  WORKSTATION
  SERVER
}

enum ComponentType {
  RAM
  STORAGE_SSD
  STORAGE_HDD
  GPU
  CPU
  MOTHERBOARD
  POWER_SUPPLY
  NETWORK_CARD
  OTHER
}

enum ComponentStatus {
  IN_STOCK
  INSTALLED
  DEFECTIVE
  RETIRED
}

enum ComponentTransferAction {
  INSTALLED_FROM_STOCK
  DETACHED_TO_STOCK
  TRANSFERRED_BETWEEN_DEVICES
  MARKED_DEFECTIVE
  RETIRED
}

enum PrinterStatus {
  WORKING
  IN_REPAIR
}

enum PrinterConnectionType {
  ETHERNET
  WIFI
  ETHERNET_AND_WIFI
  USB
}

enum AuditAction {
  DEVICE_CREATED
  DEVICE_UPDATED
  DEVICE_STATUS_CHANGED
  DEVICE_ASSIGNED
  DEVICE_UNASSIGNED
  DEVICE_DELETED
  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  EMPLOYEE_DELETED
  USER_CREATED
  USER_ROLE_UPDATED
  USER_PASSWORD_RESET
  USER_DELETED
  PRINTER_CREATED
  PRINTER_UPDATED
  PRINTER_STATUS_CHANGED
  PRINTER_INK_REFILLED
  PRINTER_DELETED
  COMPONENT_CREATED
  COMPONENT_UPDATED
  COMPONENT_INSTALLED
  COMPONENT_DETACHED
  COMPONENT_TRANSFERRED
  COMPONENT_DELETED
}

enum AuditEntityType {
  DEVICE
  EMPLOYEE
  USER
  ASSIGNMENT
  PRINTER
  COMPONENT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(MANAGER)
  employeeId   String?    @unique
  employee     Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Employee {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  department  String
  user        User?
  assignments Assignment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Device {
  id             String              @id @default(cuid())
  deviceType     DeviceType          @default(LAPTOP)
  brand          String
  model          String
  cpu            String
  ram            String
  storage        String
  serialNumber   String              @unique
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  status         DeviceStatus        @default(IN_STOCK)
  assignments    Assignment[]
  repairs        RepairRecord[]
  components     Component[]
  transfersFrom  ComponentTransfer[] @relation("TransfersFrom")
  transfersTo    ComponentTransfer[] @relation("TransfersTo")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([deviceType])
}

model Assignment {
  id           String    @id @default(cuid())
  deviceId     String
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  @@index([deviceId])
  @@index([employeeId])
}

model RepairRecord {
  id               String    @id @default(cuid())
  deviceId         String
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issueDescription String
  resolutionNotes  String?
  vendor           String?
  reportedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  reportedByEmail  String
  resolvedByEmail  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([deviceId])
  @@index([resolvedAt])
}

model AuditLog {
  id          String          @id @default(cuid())
  action      AuditAction
  entityType  AuditEntityType
  entityId    String?
  entityName  String?
  actorId     String?
  actor       User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String
  actorRole   Role
  details     String?         // Formatted JSON string containing action metadata/diff
  createdAt   DateTime        @default(now())

  @@index([action])
  @@index([entityType])
  @@index([actorEmail])
  @@index([createdAt])
}

model Printer {
  id                 String                @id @default(cuid())
  brand              String
  model              String
  ipAddress          String
  macAddress         String
  status             PrinterStatus         @default(WORKING)
  location           String?
  // Hardware Capabilities
  isColor            Boolean               @default(false)
  canScan            Boolean               @default(true)
  canCopy            Boolean               @default(true)
  isDuplex           Boolean               @default(true)
  connectionType     PrinterConnectionType @default(ETHERNET)
  driverUrl          String?
  lastInkRefillDate  DateTime?
  lastInkRefillNotes String?
  repairs            PrinterRepairRecord[]
  inkRefills         PrinterInkRefill[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status])
  @@index([ipAddress])
  @@index([isColor])
  @@index([connectionType])
}

model PrinterRepairRecord {
  id               String    @id @default(cuid())
  printerId        String
  printer          Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  issueDescription String
  resolutionNotes  String?
  vendor           String?
  reportedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  reportedByEmail  String
  resolvedByEmail  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([printerId])
  @@index([resolvedAt])
}

model PrinterInkRefill {
  id              String   @id @default(cuid())
  printerId       String
  printer         Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  refillDate      DateTime @default(now())
  notes           String?
  refilledByEmail String
  createdAt       DateTime @default(now())

  @@index([printerId])
  @@index([refillDate])
}

model Component {
  id           String          @id @default(cuid())
  type         ComponentType
  brand        String          // e.g. Samsung, Corsair, Kingston, Crucial, Nvidia
  model        String          // e.g. 980 Pro, Vengeance LPX, RTX 4060
  capacity     String?         // e.g. "16 GB", "1 TB", "850 W"
  specs        String?         // e.g. "DDR4 3200MHz CL16", "NVMe PCIe 4.0 M.2", "GDDR6"
  serialNumber String          @unique // Essential for individual tracking
  status       ComponentStatus @default(IN_STOCK)
  notes        String?

  // Current physical mounting location (null if in IT storage shelf)
  deviceId     String?
  device       Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  // Full chronological transfer trail
  transfers    ComponentTransfer[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([type])
  @@index([status])
  @@index([deviceId])
}

model ComponentTransfer {
  id               String                  @id @default(cuid())
  componentId      String
  component        Component               @relation(fields: [componentId], references: [id], onDelete: Cascade)

  fromDeviceId     String?
  fromDevice       Device?                 @relation("TransfersFrom", fields: [fromDeviceId], references: [id], onDelete: SetNull)
  fromDeviceName   String?                 // Preserves audit trail even if device is deleted

  toDeviceId       String?
  toDevice         Device?                 @relation("TransfersTo", fields: [toDeviceId], references: [id], onDelete: SetNull)
  toDeviceName     String?                 // Preserves audit trail

  actionType       ComponentTransferAction
  reason           String?                 // e.g. "Upgraded user to 32GB RAM", "Salvaged working SSD"
  performedByEmail String
  transferredAt    DateTime                @default(now())

  @@index([componentId])
  @@index([fromDeviceId])
  @@index([toDeviceId])
  @@index([transferredAt])
}
