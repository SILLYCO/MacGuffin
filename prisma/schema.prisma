generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  IT
  MANAGER
}

enum DeviceStatus {
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  RETIRED
}

enum DeviceType {
  LAPTOP
  DESKTOP_PC
  WORKSTATION
  SERVER
}

enum ComponentType {
  RAM
  STORAGE_SSD
  STORAGE_HDD
  GPU
  CPU
  MOTHERBOARD
  POWER_SUPPLY
  NETWORK_CARD
  PERIPHERAL_MOUSE
  PERIPHERAL_KEYBOARD
  PERIPHERAL_MONITOR
  CABLES_ADAPTERS
  OTHER
}

enum ComponentStatus {
  IN_STOCK
  INSTALLED
  DEFECTIVE
  RETIRED
}

enum ComponentTransferAction {
  INSTALLED_FROM_STOCK
  DETACHED_TO_STOCK
  TRANSFERRED_BETWEEN_DEVICES
  MARKED_DEFECTIVE
  RETIRED
}

enum PrinterStatus {
  WORKING
  IN_REPAIR
}

enum PrinterConnectionType {
  ETHERNET
  WIFI
  ETHERNET_AND_WIFI
  USB
}

enum AuditAction {
  DEVICE_CREATED
  DEVICE_UPDATED
  DEVICE_STATUS_CHANGED
  DEVICE_ASSIGNED
  DEVICE_UNASSIGNED
  DEVICE_DELETED
  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  EMPLOYEE_DELETED
  USER_CREATED
  USER_ROLE_UPDATED
  USER_PASSWORD_RESET
  USER_DELETED
  PRINTER_CREATED
  PRINTER_UPDATED
  PRINTER_STATUS_CHANGED
  PRINTER_INK_REFILLED
  PRINTER_DELETED
  COMPONENT_CREATED
  COMPONENT_UPDATED
  COMPONENT_INSTALLED
  COMPONENT_DETACHED
  COMPONENT_TRANSFERRED
  COMPONENT_DELETED
  PURCHASE_CREATED
  PURCHASE_UPDATED
  PURCHASE_DELETED
  CREDENTIAL_CREATED
  CREDENTIAL_UPDATED
  CREDENTIAL_DELETED
  CREDENTIAL_REVEALED
  CREDENTIAL_DEPROVISIONED
  NETWORK_DEVICE_CREATED
  NETWORK_DEVICE_UPDATED
  NETWORK_DEVICE_DELETED
  NETWORK_PORT_PATCHED
  NETWORK_PORT_UNPATCHED
}

enum AuditEntityType {
  DEVICE
  EMPLOYEE
  USER
  ASSIGNMENT
  PRINTER
  COMPONENT
  PURCHASE
  CREDENTIAL
  NETWORK_DEVICE
  NETWORK_CONNECTION
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(MANAGER)
  employeeId   String?    @unique
  employee     Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Employee {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  department  String
  user        User?
  assignments Assignment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Device {
  id             String              @id @default(cuid())
  deviceType     DeviceType          @default(LAPTOP)
  brand          String
  model          String
  cpu            String
  ram            String
  storage        String
  serialNumber   String              @unique
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  status         DeviceStatus        @default(IN_STOCK)
  assignments    Assignment[]
  repairs        RepairRecord[]
  components     Component[]
  transfersFrom      ComponentTransfer[] @relation("TransfersFrom")
  transfersTo        ComponentTransfer[] @relation("TransfersTo")
  networkConnections NetworkConnection[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([deviceType])
}

model Assignment {
  id           String    @id @default(cuid())
  deviceId     String
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  @@index([deviceId])
  @@index([employeeId])
}

model RepairRecord {
  id               String    @id @default(cuid())
  deviceId         String
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issueDescription String
  resolutionNotes  String?
  vendor           String?
  reportedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  reportedByEmail  String
  resolvedByEmail  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([deviceId])
  @@index([resolvedAt])
}

model AuditLog {
  id          String          @id @default(cuid())
  action      AuditAction
  entityType  AuditEntityType
  entityId    String?
  entityName  String?
  actorId     String?
  actor       User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String
  actorRole   Role
  details     String?         // Formatted JSON string containing action metadata/diff
  createdAt   DateTime        @default(now())

  @@index([action])
  @@index([entityType])
  @@index([actorEmail])
  @@index([createdAt])
}

model Printer {
  id                 String                @id @default(cuid())
  brand              String
  model              String
  ipAddress          String
  macAddress         String
  status             PrinterStatus         @default(WORKING)
  location           String?
  // Hardware Capabilities
  isColor            Boolean               @default(false)
  canScan            Boolean               @default(true)
  canCopy            Boolean               @default(true)
  isDuplex           Boolean               @default(true)
  connectionType     PrinterConnectionType @default(ETHERNET)
  driverUrl          String?
  lastInkRefillDate  DateTime?
  lastInkRefillNotes String?
  repairs            PrinterRepairRecord[]
  inkRefills         PrinterInkRefill[]
  networkConnections NetworkConnection[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status])
  @@index([ipAddress])
  @@index([isColor])
  @@index([connectionType])
}

model PrinterRepairRecord {
  id               String    @id @default(cuid())
  printerId        String
  printer          Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  issueDescription String
  resolutionNotes  String?
  vendor           String?
  reportedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  reportedByEmail  String
  resolvedByEmail  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([printerId])
  @@index([resolvedAt])
}

model PrinterInkRefill {
  id              String   @id @default(cuid())
  printerId       String
  printer         Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  refillDate      DateTime @default(now())
  notes           String?
  refilledByEmail String
  createdAt       DateTime @default(now())

  @@index([printerId])
  @@index([refillDate])
}

model Component {
  id           String          @id @default(cuid())
  type         ComponentType
  brand        String          // e.g. Samsung, Corsair, Kingston, Crucial, Nvidia
  model        String          // e.g. 980 Pro, Vengeance LPX, RTX 4060
  capacity     String?         // e.g. "16 GB", "1 TB", "850 W"
  specs        String?         // e.g. "DDR4 3200MHz CL16", "NVMe PCIe 4.0 M.2", "GDDR6"
  serialNumber String          @unique // Essential for individual tracking
  status       ComponentStatus @default(IN_STOCK)
  notes        String?

  // Current physical mounting location (null if in IT storage shelf)
  deviceId     String?
  device       Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  // Optional procurement link
  purchaseItemId String?
  purchaseItem   PurchaseItem?   @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  purchasePrice  Float?

  // Full chronological transfer trail
  transfers    ComponentTransfer[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([type])
  @@index([status])
  @@index([deviceId])
  @@index([purchaseItemId])
}

model ComponentTransfer {
  id               String                  @id @default(cuid())
  componentId      String
  component        Component               @relation(fields: [componentId], references: [id], onDelete: Cascade)

  fromDeviceId     String?
  fromDevice       Device?                 @relation("TransfersFrom", fields: [fromDeviceId], references: [id], onDelete: SetNull)
  fromDeviceName   String?                 // Preserves audit trail even if device is deleted

  toDeviceId       String?
  toDevice         Device?                 @relation("TransfersTo", fields: [toDeviceId], references: [id], onDelete: SetNull)
  toDeviceName     String?                 // Preserves audit trail

  actionType       ComponentTransferAction
  reason           String?                 // e.g. "Upgraded user to 32GB RAM", "Salvaged working SSD"
  performedByEmail String
  transferredAt    DateTime                @default(now())

  @@index([componentId])
  @@index([fromDeviceId])
  @@index([toDeviceId])
  @@index([transferredAt])
}

enum PurchaseCategory {
  RAM
  STORAGE_SSD
  STORAGE_HDD
  GPU
  CPU
  MOTHERBOARD
  POWER_SUPPLY
  NETWORK_CARD
  PERIPHERAL_MOUSE
  PERIPHERAL_KEYBOARD
  PERIPHERAL_MONITOR
  CABLES_ADAPTERS
  STICKERS_COVERS
  CONSUMABLE
  OTHER
}

model Purchase {
  id            String         @id @default(cuid())
  title         String?        // Optional summary or label
  vendor        String         // Store / Supplier name (e.g. Amazon EG, El Bostan Mall, B.TECH)
  invoiceNumber String?        // Receipt / Invoice ref number
  purchaseDate  DateTime       @default(now())
  totalAmount   Float          // Calculated sum of all item line totals in EGP
  currency      String         @default("EGP")
  notes         String?
  purchasedBy   String         // Email of the IT user who logged the purchase
  items         PurchaseItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([purchaseDate])
  @@index([vendor])
}

model PurchaseItem {
  id          String           @id @default(cuid())
  purchaseId  String
  purchase    Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  name        String           // e.g. "Kingston 16GB DDR4", "Arabic/English Keyboard Stickers"
  category    PurchaseCategory @default(OTHER)
  unitPrice   Float            // Price per unit in EGP
  quantity    Int              @default(1)
  totalPrice  Float            // unitPrice * quantity in EGP
  isTracked   Boolean          @default(true) // false = expense proof only (e.g. stickers, thermal paste)
  autoStocked Boolean          @default(false) // true if spare parts were generated into Components inventory
  notes       String?
  components  Component[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([purchaseId])
  @@index([category])
  @@index([isTracked])
}

enum NetworkDeviceType {
  ROUTER
  SWITCH
  ACCESS_POINT
  FIREWALL
  PATCH_PANEL
  OTHER
}

enum NetworkDeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum CableType {
  CAT5E
  CAT6
  CAT6A
  CAT7
  CAT8
  FIBER_SINGLE_MODE
  FIBER_MULTI_MODE
  DAC_COPPER
  OTHER
}

enum ConnectionSpeed {
  SPEED_100_MBPS
  SPEED_1_GBPS
  SPEED_2_5_GBPS
  SPEED_10_GBPS
  SPEED_40_GBPS
  SPEED_100_GBPS
  OTHER
}

model NetworkDevice {
  id                  String              @id @default(cuid())
  name                String              // e.g. "Main Office Router", "Core Switch Rack A"
  deviceType          NetworkDeviceType   @default(SWITCH)
  brand               String              // e.g. "Cisco", "Ubiquiti", "MikroTik", "TP-Link", "Aruba"
  model               String              // e.g. "Catalyst 2960X", "UniFi Pro 24 PoE"
  ipAddress           String?             // e.g. "192.168.1.1"
  macAddress          String?             // e.g. "00:11:22:33:44:55"
  location            String?             // e.g. "Server Rack A", "Floor 2 Ceiling AP"
  totalPorts          Int                 @default(24)
  status              NetworkDeviceStatus @default(ONLINE)
  notes               String?

  // Connections originating from this device's ports
  outgoingConnections NetworkConnection[] @relation("OriginDevice")
  // Uplink connections targeting this device from another switch/router
  incomingConnections NetworkConnection[] @relation("TargetNetworkDevice")

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([deviceType])
  @@index([status])
}

model NetworkConnection {
  id                    String          @id @default(cuid())

  // Origin (Switch / Router)
  fromDeviceId          String
  fromDevice            NetworkDevice   @relation("OriginDevice", fields: [fromDeviceId], references: [id], onDelete: Cascade)
  fromPort              Int             // e.g., 1..48
  fromPortLabel         String?         // e.g., "Port 1", "SFP+ 1", "WAN 1"

  // Destination Option A: Another Network Device (Uplink / Trunk between switches)
  targetNetworkDeviceId String?
  targetNetworkDevice   NetworkDevice?  @relation("TargetNetworkDevice", fields: [targetNetworkDeviceId], references: [id], onDelete: SetNull)
  targetNetworkPort     Int?            // Destination port on the other switch/router

  // Destination Option B: Computer / Workstation in Device Inventory
  targetDeviceId        String?
  targetDevice          Device?         @relation(fields: [targetDeviceId], references: [id], onDelete: SetNull)

  // Destination Option C: Network Printer in Printer Inventory
  targetPrinterId       String?
  targetPrinter         Printer?        @relation(fields: [targetPrinterId], references: [id], onDelete: SetNull)

  // Destination Option D: Generic / Custom Endpoint (e.g., "Wall Plate 3B", "Meeting Room TV", "CCTV Camera")
  endpointName          String?
  endpointType          String?         // "WALL_JACK", "CCTV", "SMART_TV", "VOIP_PHONE", "OTHER"

  // Cable & Link Specifications
  cableType             CableType       @default(CAT6)
  cableColor            String?         // e.g., "Blue", "Yellow", "Red", "Green", "Purple"
  speed                 ConnectionSpeed @default(SPEED_1_GBPS)
  vlan                  String?         // e.g., "10 (Corporate)", "20 (Printers)", "Trunk"
  wallOutlet            String?         // e.g., "Outlet 4A - Room 201"
  notes                 String?

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([fromDeviceId, fromPort])    // Physical constraint: 1 cable per port
  @@index([fromDeviceId])
  @@index([targetDeviceId])
  @@index([targetPrinterId])
  @@index([targetNetworkDeviceId])
}

